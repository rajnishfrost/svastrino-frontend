# Client env — copy to .env.local for overrides.
# In dev the Vite proxy forwards /api to the backend (see vite.config.js),
# so VITE_API_BASE is only needed if you call the API on a different origin.
VITE_API_BASE=/api

# Google sign-in — the OAuth Client ID (public; safe to ship to the browser).
# Must match GOOGLE_CLIENT_ID in the server's .env.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
